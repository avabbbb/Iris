# Tauri
src-tauri/target/
# 平台特定的 sidecar 二进制由 CI 在 build 阶段从 src/bin/host.rs 编译，不入库
src-tauri/binaries/
src-tauri/.tauri_private_key
src-tauri/.tauri_private_key.pub
.flovart/

# dsh-plugin build output
dsh-plugin/lib/
dsh-plugin/skill/

# FlovartBench raw evidence: trajectories and snapshots for every trial.
# The generated reports under eval/reports/ are the artifact of record; the raw
# per-trial files are uploaded as CI artifacts instead of committed.
eval/results/

# Root-level artifacts directory (smoke screenshots, recordings)
artifacts/


# Product-maturity eval results: large video/screenshot artifacts, not source
eval/product-maturity/results/


# Product-maturity dev/probe scripts are exploration scratch, not source
eval/product-maturity/dev/
eval/product-maturity/scenarios/


# Historical evaluation media is evidence output, not source. Keep reports,
# specs and verification JSON in Git; publish generated binaries as CI/Release artifacts.
tools/flovart/evaluations/**/*.mp4
tools/flovart/evaluations/**/*.wav
tools/flovart/evaluations/**/*.png
tools/flovart/evaluations/**/*.jpg
tools/flovart/evaluations/**/*.jpeg

# local reference clones (license-incompatible, never commit)
_ref/
dsh-plugin/webui/

# Third-party articles saved for reference only (copyright of the original authors); not redistributed.
eval/references/*.html

# Judge runs (results.jsonl / summary.json / report.md) are generated evidence.
eval/judge/results/

# Cloudflare wrangler local state / secrets
.wrangler/
.dev.vars
