{
  "name": "flovart",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:critical": "node scripts/run-critical-suite.mjs",
    "e2e:pipeline": "node scripts/e2e-pipeline-trace.mjs",
    "e2e:pipeline:parity": "node scripts/e2e-pipeline-parity.mjs",
    "e2e:pipeline:remotion": "node scripts/e2e-pipeline-remotion.mjs",
    "e2e:pipeline:capture": "node scripts/e2e-pipeline-capture.mjs",
    "test:browser:chrome": "node scripts/chrome-browser-smoke.mjs",
    "test:browser:responsive": "node scripts/responsive-agent-link-smoke.mjs",
    "release:red-team": "node scripts/release-red-team.mjs",
    "release:artifacts:check": "node scripts/check-release-artifacts.mjs",
    "release:updater:check": "node scripts/check-updater-artifacts.mjs",
    "release:secret-audit": "node scripts/release-secret-audit.mjs",
    "release:dependency-audit": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "docs:check": "node scripts/check-docs-contract.mjs",
    "test:watch": "vitest",
    "flovart:cli": "node tools/flovart/cli.js",
    "flovart:agent": "node agent/index.js",
    "dsh:profile:install": "npm --prefix dsh-plugin run build && npm --prefix dsh-plugin run profile:install",
    "dsh:start": "npm run dsh:profile:install && npm --prefix dsh-plugin run profile:start",
    "prototype:vox-film": "node tools/flovart/prototypes/vox-film/index.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.local.conf.json",
    "tauri:build:release": "tauri build",
    "ext:build": "node extension/build.mjs",
    "studio:build": "node integrations/studio/build.mjs",
    "workbuddy:build": "node integrations/workbuddy/build.mjs",
    "workbuddy:validate": "node scripts/check-workbuddy-connector.mjs",
    "build:agent-toolkit": "node tools/flovart/scripts/build-agent-toolkit.mjs",
    "version:check": "node scripts/check-release-version.mjs",
    "publish:cli": "cd tools/flovart && npm publish",
    "deploy:cf": "vite build && npx wrangler pages deploy dist",
    "eval:validate": "node eval/run.mjs validate",
    "eval:oracle": "node eval/run.mjs oracle",
    "eval:core": "node eval/run.mjs run --group core",
    "eval:agent": "node eval/run.mjs run --group agent",
    "eval:report": "node eval/run.mjs report",
    "eval:redteam": "node eval/red-team.mjs",
    "eval:judge": "node eval/judge/run.mjs",
    "eval:judge:validate": "node eval/judge/run.mjs validate",
    "eval:judge:demo": "node eval/judge/run.mjs judge --rubric agent-run --replay eval/judge/samples/agent-run.replay.jsonl --samples eval/judge/samples/agent-run.samples.jsonl --labels eval/judge/samples/agent-run.labels.json",
    "session:browser": "node scripts/codex-session-browser.mjs",
    "dsh:desktop": "node scripts/dsh-desktop.mjs",
    "trial:runninghub-tts": "node scripts/trial-runninghub-tts.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-storage-sqlite-node": "0.82.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^1.48.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^2.1.2",
    "@noble/hashes": "^2.4.0",
    "@remotion/player": "^4.0.542",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-mention": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/suggestion": "^3.20.0",
    "@zip.js/zip.js": "^2.8.26",
    "antd": "^6.4.4",
    "aws4fetch": "1.0.20",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.10.1",
    "imagetracerjs": "^1.2.6",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "json-canonicalize": "^2.0.0",
    "konva": "^10.3.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.20.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.16",
    "polygon-clipping": "^0.15.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.2.4",
    "react-router": "^7.18.2",
    "remotion": "^4.0.542",
    "thinking-orbs": "^0.3.2",
    "tippy.js": "^6.3.7",
    "undici": "^6.28.1",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.0.17",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.542",
    "@remotion/renderer": "^4.0.542",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "~2.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.1",
    "playwright": "^1.60.0",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.2.2",
    "tar": "^7.5.20",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  },
  "description": "Flovart — an open-source, local-first AI creative layer for professional editing tools."
}
